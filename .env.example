# Bot Configuration
TELEGRAM_BOT_TOKEN='your_telegram_bot_token'

# Wallet Configuration (Base Mainnet — USDC + ETH for gas)
# 0x prefix is optional — handled in config.ts
WALLET_PRIVATE_KEY='your_burner_wallet_private_key'

# Optional: Daily budget limit in USD (default: 5.00)
DAILY_BUDGET_LIMIT='5.00'

# x402 HTTP Server — wallet that RECEIVES payments from API users
# Can be the same as your buyer wallet or a separate one
PROVIDER_WALLET_ADDRESS='0x_YOUR_RECEIVING_WALLET_ADDRESS'
SERVER_PORT=3000

# Coinbase CDP credentials — required for Base MAINNET payment processing
# Get free at: https://portal.cdp.coinbase.com → API Keys → Create
# Without these, server runs on Base Sepolia testnet (dev mode)
CDP_API_KEY_ID='your_cdp_api_key_id'
CDP_API_KEY_SECRET='your_cdp_api_key_secret'
