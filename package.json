{
    "name": "messari-pro-bot",
    "version": "2.0.0",
    "description": "Multi-endpoint Telegram research terminal powered by Messari + x402 payments",
    "main": "index.js",
    "scripts": {
        "predev": "test -f src/prompts.ts || cp src/prompts.example.ts src/prompts.ts",
        "prebuild": "test -f src/prompts.ts || cp src/prompts.example.ts src/prompts.ts",
        "dev": "ts-node-dev --respawn --transpile-only src/bot/bot.ts",
        "build": "tsc",
        "start": "node dist/bot/bot.js",
        "start:all": "concurrently \"node dist/bot/bot.js\" \"node dist/server/server.js\"",
        "test": "echo \"Error: no test specified\" && exit 1",
        "start:server": "node dist/server/server.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@coinbase/x402": "^2.1.0",
        "@types/express": "^5.0.6",
        "@x402/core": "^2.14.0",
        "@x402/evm": "^2.14.0",
        "@x402/express": "^2.14.0",
        "@x402/fetch": "^2.14.0",
        "concurrently": "^9.2.1",
        "dotenv": "^16.4.5",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "grammy": "^1.30.0",
        "viem": "^2.21.0"
    },
    "devDependencies": {
        "@types/node": "^22.5.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.4"
    }
}
